# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Supabase > Project Settings > API

# URL do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave SECRETA (service_role / secret). Nunca coloque no front-end nem no GitHub!
SUPABASE_SERVICE_KEY=

# Chave PÚBLICA (publishable / anon). Usada pelo botão "Entrar com Google".
SUPABASE_PUBLISHABLE_KEY=

# ID do cliente "Aplicativo da Web" do Google (termina em .apps.googleusercontent.com).
# Usado pelo login nativo do app Android. Não é segredo, mas fica aqui para ser configurável.
GOOGLE_WEB_CLIENT_ID=

# E-mail Google do dono da plataforma (o primeiro fabricante, que convida os outros)
DONO_EMAIL=

# Qualquer texto longo e aleatório. Usado para assinar o token de login.
JWT_SECRET=troque-por-um-texto-bem-longo-e-aleatorio

# Porta local (o Render define a dele sozinho)
PORT=3000
